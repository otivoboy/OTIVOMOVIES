# ==========================================
# OTIVO MOVIES - ENVIRONMENT CONFIGURATION
# ==========================================

# -------------------------
# AI & App Environment
# -------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VITE_APP_NAME="OTIVO Movies"
NEXT_PUBLIC_APP_NAME="OTIVO Movies"
NODE_ENV="development"

# -------------------------
# Database - PostgreSQL
# -------------------------
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/otivo_movies?schema=public"

# -------------------------
# TMDB (Movie metadata, posters, backdrops, cast, genres, release information)
# -------------------------
TMDB_API_KEY="18636b006bc9b650d0029e39d6c1b0ad"
TMDB_API_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# -------------------------
# Watchmode (Streaming availability & provider links)
# -------------------------
WATCHMODE_API_KEY="wm_KpLKNZzVv9EtQr1FLtvUQODC-0ud1vz95yqkPGo-vhk"
WATCHMODE_API_BASE_URL="https://api.watchmode.com"

# -------------------------
# Authentication
# -------------------------
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
AUTH_URL="http://localhost:3000"

# -------------------------
# Redis Caching (Optional during initial development)
# -------------------------
REDIS_URL="redis://localhost:6379"

# -------------------------
# Search (Optional Meilisearch)
# -------------------------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="YOUR_MEILISEARCH_KEY"

# -------------------------
# Object Storage (For OTIVO-owned/licensed video assets)
# -------------------------
STORAGE_ENDPOINT="https://YOUR-STORAGE-ENDPOINT"
STORAGE_REGION="YOUR_REGION"
STORAGE_ACCESS_KEY="YOUR_ACCESS_KEY"
STORAGE_SECRET_KEY="YOUR_SECRET_KEY"
STORAGE_BUCKET="otivo-movies"

# -------------------------
# CDN & Video Streams
# -------------------------
CDN_URL="https://cdn.yourdomain.com"
VIDEO_CDN_URL="https://cdn.yourdomain.com/videos"

# -------------------------
# Cron / Background Jobs
# -------------------------
CRON_SECRET="GENERATE_ANOTHER_RANDOM_SECRET"

# -------------------------
# Admin
# -------------------------
ADMIN_EMAIL="otivoai@gmail.com"
